  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "test:python": "python3 -m unittest discover -s ml/tests -p '*test*.py'",
    "backfill:tmdb": "node scripts/backfillTMDBMetadata.js",
    "backfill:tmdb:apply": "node scripts/backfillTMDBMetadata.js --apply",
    "backfill:demo-watching": "node scripts/backfillDemoWatchingStatus.js",
    "backfill:demo-watching:apply": "node scripts/backfillDemoWatchingStatus.js --apply",
    "backfill:signals": "node scripts/backfillSignalMetadata.js",
    "backfill:signals:apply": "node scripts/backfillSignalMetadata.js --apply",
    "backfill:ignored-metadata": "node scripts/backfillIgnoredSuggestionMetadata.js",
    "backfill:ignored-metadata:apply": "node scripts/backfillIgnoredSuggestionMetadata.js --apply",
    "audit:data": "node scripts/auditRecommendationData.js",
    "audit:data:json": "node scripts/auditRecommendationData.js --json",
    "report:baseline": "node scripts/baselineRecommendationReport.js",
    "report:baseline:json": "node scripts/baselineRecommendationReport.js --json",
    "report:signals": "node scripts/recommendationSignalReport.js",
    "report:signals:json": "node scripts/recommendationSignalReport.js --json",
    "export:training-data": "node scripts/exportTrainingData.js",
    "export:training-data:json": "node scripts/exportTrainingData.js --json",
    "analyze:training-data": "node scripts/analyzeTrainingData.js",
    "analyze:training-data:json": "node scripts/analyzeTrainingData.js --json",
    "evaluate:recommendations": "node scripts/evaluateRecommendations.js",
    "evaluate:recommendations:json": "node scripts/evaluateRecommendations.js --json",
    "experiment:vector": "node scripts/runVectorExperiment.js",
    "experiment:vector:json": "node scripts/runVectorExperiment.js --json",
    "ml:export-training": "node scripts/writeTrainingDataExport.js",
    "ml:learn-weights": "node scripts/writeTrainingDataExport.js --output=.codex-private/training-data.json --limit=5000 && python3 ml/experiments/vector_weight_learning.py --input=.codex-private/training-data.json --output=.codex-private/learned-vector-weights.json"
  },
